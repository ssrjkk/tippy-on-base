# Response headers for everything the Pages bundle serves itself — style.css,
# the scripts, the fonts and the images. Documents never come from here: the
# Function proxies them to the origin, which sets its own CSP, nonce and cookie
# flags.
#
# Without this file the same site answers a page with nosniff and an asset
# without it, and the weaker half is the one a mislabelled upload reaches.
#
# The two Cache-Control windows below are the same pairs `web/server.py` stamps
# in `BundleFiles`, so a visitor who reaches the VPS directly and a visitor who
# reaches it through Pages are promised one policy for one file. Tests read both
# copies and fail on the difference.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

# Code the pages load: five minutes of freshness, then what is already on hand
# paints while the browser fetches the current file in the background. So a
# deploy lands on the next visit instead of waiting for a hard refresh, and a
# repeat visit pays no blocking round trip for it at all.
/*.css
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

/*.js
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

# The faces and the pictures change with a design, not with a page view, so they
# may be a day old and still arrive before the visitor finishes reading.
/fonts/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/*.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
